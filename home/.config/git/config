[core]
	excludesfile = ~/.gitignore_global
	editor = code --wait
	ignorecase = false
[user]
	email = 1761115+seanogdev@users.noreply.github.com
	name = "Sean O'Grady"
[pager]
	branch = false
[pull]
	rebase = false
[push]
  autoSetupRemote=true
[fetch]
  prune = true
[init]
	defaultBranch = main
[alias]
	undo = reset --keep HEAD@{1}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
